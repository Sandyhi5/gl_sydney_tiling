# Case 1, 4  - HTTP redirect for www.gltilingsydney.com.au, gltilingsydney.com.au to HTTPS
server {
	listen 80;
	server_name gltilingsydney.com.au www.gltilingsydney.com.au;

    # Run this for automatic config:
    #   sudo certbot --nginx -d example.com
    # Else:
    #   sudo certbot certonly --webroot -w /var/www/html -d example.com
    #
    # ONLY NEEDED when Nginx DOES NOT automatically configure temporarily
    # for domain verification.
	# Added this for Lets Encrypt certificate renewal
	# Refer discussion in ChatGPT for reasoning
	#location /.well-known/acme-challenge/ {
	#	root /var/www/html;
	#	allow all;
	#}

    # Redirect all HTTP to HTTPS - path and other parts included
	location / {
	    return 301 https://$host$request_uri;
	}
}

# Case 2, 3 - HTTPS redirect for gltilingsydney.com.au
server {
	listen 443 ssl;
	server_name gltilingsydney.com.au www.gltilingsydney.com.au;

    # SSL configurations
	ssl_certificate /etc/letsencrypt/live/gltilingsydney.com.au/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/gltilingsydney.com.au/privkey.pem;
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

	# Recommended, included: Ensure Nginx supports ECDSA
	ssl_ecdh_curve prime256v1;

	# Required if fetching fonts etc from other servers: Add CORS headers
	add_header Access-Control-Allow-Origin "*";
	add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
	add_header Access-Control-Allow-Headers "X-Requested-With, Content-Type, Authorization";

	# Root dir - indicates root directory for entire server
	# THIS IS WHERE index.html IS
	root /var/www/gltilingsydney;
	index index.html;


	# NOTE: try_files only serves static files by default
	location / {
		try_files $uri $uri/ /index.html;
	}

    # Don’t cache index.html and core JS files - allows updates
    location ~* \.(html|js|json|webmanifest)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

	# Static assets (like images or fonts) cache them, they have unique hashes in name
    location /assets/ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Gzip for performance
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 256;

    # Optional: increase body size if uploading forms/media
    client_max_body_size 5M;

# -----------------------------------------------
error_log /var/log/nginx/error.log notice;
