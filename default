# Case 1, 4  - HTTP redirect for www.vaanihub.com, vaanihub.com to HTTPS
server {
	listen 80;
	server_name vaanihub.com www.vaanihub.com;

	# Added this for Lets Encrypt certificate renewal
	# Refer discussion in ChatGPT for reasoning
	location /.well-known/acme-challenge/ {
		root /var/www/html;
		allow all;
	}

	location / {
		return 301 https://vaanihub.com;
	}
}




# Case 2 - HTTPS redirect for www.vaanihub.com --> vaanihub.com secure
server {
	listen 443 ssl; 
	# default_server;
	server_name www.vaanihub.com;

	ssl_certificate /etc/letsencrypt/live/vaanihub.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/vaanihub.com/privkey.pem;

	# Redirect www to non-www on HTTPS ie over to Case# 3
	return 301 https://vaanihub.com;
}



